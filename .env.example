# Slack tokens — get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Authorized Slack user IDs (comma-separated)
# Find your ID: Slack profile → ⋮ → Copy member ID
# Leave empty to allow all users
AUTHORIZED_USERS=U04BNAB7QRY

# Working directory — the folder Claude runs from when invoked via Slack.
# Set to home so the bot can access everything on the machine.
# Combined with passwordless sudo and --permission-mode bypassPermissions,
# your AI cofounder has full root access to the entire machine.
PROJECT_DIR=/Users/anishekkamal-ai-server/Projects/bespoke_backend

# Claude CLI timeout in seconds (default: 7200 = 2 hours)
CLAUDE_TIMEOUT=7200

# Claude model and reasoning effort passed to the claude CLI
# Defaults shown; requires a Claude Code CLI recent enough to support --effort
CLAUDE_MODEL=claude-opus-5[1m]
CLAUDE_EFFORT=medium

# HTTP server port (Cloudflare Tunnel points to this)
PORT=3000

# Bot identity — used in thread context and logging
# BOT_USER_ID is the bot's workspace member ID (starts with U), not the App ID from Basic Information
# Get it via: curl -s -H "Authorization: Bearer xoxb-..." https://slack.com/api/auth.test → "user_id" field
# Or in Slack: open the bot's profile → ⋮ menu → Copy member ID
BOT_USER_ID=
BOT_DISPLAY_NAME=Goku

# --- Permission tiers ---

# Supervisor users get --permission-mode bypassPermissions (full access).
# If not set, all AUTHORIZED_USERS are treated as supervisors.
SUPERVISOR_USERS=

# Restricted users get limited tool access via --allowedTools / --disallowedTools.
# Useful for team members who should interact with the bot but not have full access.
RESTRICTED_USERS=
RESTRICTED_ALLOWED_TOOLS=Read,Edit,Write,Grep,Glob,Bash,WebSearch,WebFetch,Agent
RESTRICTED_DISALLOWED_TOOLS=

# --- Channel filtering ---

# Only respond in channels whose names contain one of these entries as a substring (comma-separated).
# Leave empty to respond in all channels.
ALLOWED_CHANNELS=

# --- Trust battery ---

# Path to directory containing per-user trust battery JSON files.
# Leave empty to disable. See trust-battery/README.md for setup.
TRUST_BATTERY_DIR=

# --- Extensions ---

# Gemini API — image generation
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API — high-quality image generation (gpt-image-2)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
